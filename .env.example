# ==============================================================================
# StockWise - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values before starting the application:
#   cp .env.example .env
# ==============================================================================

# Node Environment ('development', 'production', or 'test')
NODE_ENV=development

# Server Port (Default: 5000)
PORT=5000

# Client Application URL (For CORS whitelist and password reset email callbacks)
CLIENT_URL=http://localhost:3000

# MongoDB Database Connection URI
# Options:
#   - Local MongoDB: mongodb://127.0.0.1:27017/stockwise
#   - MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/stockwise?retryWrites=true&w=majority
#   - Note: If MongoDB is offline, StockWise seamlessly activates its resilient In-Memory Dev Store
MONGODB_URI=mongodb://127.0.0.1:27017/stockwise

# JSON Web Token (JWT) Configuration
# Use a strong, random 256-bit cryptographically secure string in production
JWT_SECRET=stockwise_super_secure_jwt_secret_key_2026_learn_trade_grow
JWT_EXPIRES_IN=7d

# Email Service Configuration (For Forgot Password & Account Notifications)
# Options: 'console' (prints reset links directly to terminal for instant dev/testing), 'smtp' (actual mail)
EMAIL_SERVICE=console
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=StockWise Support <support@stockwise.trade>

# Market Data Provider
# Options: 'sample' (verified Indian equities: NSE/BSE benchmarks), 'alphavantage'
MARKET_DATA_PROVIDER=sample
MARKET_DATA_API_KEY=
MARKET_DATA_CACHE_TTL_SECONDS=60
